{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/potato.ans",
    "color": {
      "1": "38;2;250;179;135",
      "2": "38;2;203;166;247",
      "3": "38;2;245;194;231"
    },
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "cursor",
      "key": "│ ├",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "terminalfont",
      "key": "│ ├",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "terminal",
      "key": "│ └",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "gpu",
      "key": "│ ├󰻑",
      "format": "{2}",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "keyColor": "38;2;166;227;161",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "display",
      "key": "│ └󰍹",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{2}",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;245;224;220m \u001b[38;2;242;205;205m \u001b[38;2;245;194;231m \u001b[38;2;203;166;247m \u001b[38;2;243;139;168m \u001b[38;2;235;160;172m \u001b[38;2;250;179;135m \u001b[38;2;249;226;175m \u001b[38;2;166;227;161m \u001b[38;2;148;226;213m \u001b[38;2;137;220;235m \u001b[38;2;116;199;236m \u001b[38;2;137;180;250m \u001b[38;2;180;190;254m \u001b[38;2;137;180;250m \u001b[38;2;116;199;236m \u001b[38;2;137;220;235m \u001b[38;2;148;226;213m \u001b[38;2;166;227;161m \u001b[38;2;249;226;175m \u001b[38;2;250;179;135m \u001b[38;2;235;160;172m \u001b[38;2;243;139;168m \u001b[38;2;203;166;247m \u001b[38;2;245;194;231m \u001b[38;2;242;205;205m"
    },
    "break"
  ]
}