      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "icons",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "cursor",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "packages",
      "keyColor": "38;2;245;194;231"
    },
    {
