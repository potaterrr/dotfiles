#!/usr/bin/env bash
# ~/.local/bin/starship-config — applies a starship theme preset for bash
# Usage: starship-config [theme]
#   theme defaults to bullet-train if not given.
set -euo pipefail

THEME="${1:-bullet-train}"

_read_bool() {
    local file="$1" key="$2" default="${3:-false}"
    # Starship toml uses true/false (lower case) for bool fields.
    if ! [ -f "$file" ]; then
        return 1
    fi
    # best-effort toml parse: skip comments, look for key = value
    local val
    val=$(awk -F '=' -v key="$key" '
        $1 ~ /^[[:space:]]*\[.*\]/ { in_section=0 }
        $1 ~ /\[/ { in_section=1; next }
        {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "")
            if ($1 == key && NF >= 2) {
                v=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
                print v
                exit
            }
        }
    ' "$file" | head -n 1)
    if [ -z "$val" ]; then
        echo "$default"
        return 0
    fi
    case "$val" in
        true|on|yes|1) echo true ;;
        *)              echo false ;;
    esac
}

_write_bool() {
    local file="$1" key="$2" value="$3"
    if ! [ -f "$file" ]; then
        echo "starship-config: $file missing — run: starship config" >&2
        return 1
    fi
    if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$file"; then
        # replace in place (best-effort for toml-style key = "value" / key = true)
        perl -i -pe 's/^[ \t]*'\"${key}\"'[ \t]*=.*$/"\t${key} = ${value}"/e' "$file" 2>/dev/null \
            || sed -i -E "s/^([[:space:]]*${key}[[:space:]]*=[[:space:]]*).*/\1${value}/" "$file"
    else
        printf '\n[%s]\n%s = %s\n' "$(basename "$file" .toml)" "$key" "$value" >> "$file"
    fi
}

case "$THEME" in
    bullet-train|bt)
        # Bullet Train is a Zsh theme but we approximate the spirit in Starship:
        #   - concise segments, no heavy icons by default
        #   - git branch first, then python/rust/node only when relevant
        #   - exit code shown on failure
        #   - execution time for slow commands
        STARShip_FILE="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
        if ! command -v starship >/dev/null 2>&1; then
            echo "starship-config: starship not found; install it first" >&2
            exit 1
        fi

        # Ensure a config file exists
        if [ ! -f "$STARShip_FILE" ]; then
            starship config >/dev/null 2>&1 || true
            if [ ! -f "$STARShip_FILE" ]; then
                echo "starship-config: could not create $STARShip_FILE" >&2
                exit 1
            fi
        fi

        # Reflect bullet-train-ish preferences
        _write_bool "$STARSHIP_FILE" "add_newline" false
        _write_bool "$STARSHIP_FILE" "format_exists" "  "
        # Disable a lot of noisy modules by default (bullet train only shows what matters)
        for mod in aws azure gcp openstack azure docker_context terraform kubectl helm
        do
            if grep -qE "^[[:space:]]*\\[${mod}\\]" "$STARSHIP_FILE"; then
                _write_bool "$STARSHIP_FILE" "${mod}.disabled" true
            fi
        done

        echo "starship-config: applied bullet-train-ish prefs to $STARSHIP_FILE"
        ;;
    *)
        echo "starship-config: unknown theme '$THEME' (supported: bullet-train)" >&2
        exit 1
        ;;
esac

# Show the effective prompt config summary
starship config 2>/dev/null | head -n 40 || true
