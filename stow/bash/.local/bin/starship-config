#!/usr/bin/env bash
# ~/.local/bin/starship-config — applies the starship bullet-train preset
# for bash (and other shells). The preset is fetched verbatim from
# julienc91/starship-bullet-train so the dotfiles repo stays in sync with
# upstream.
#
# Usage:
#   starship-config [theme]
#     theme defaults to bullet-train if not given.
set -euo pipefail

THEME="${1:-bullet-train}"

DOTFILES_STARSHIP_TOML="${HOME}/git-projects/dotfiles/stow/starship/.config/starship.toml"
LIVE_STARSHIP_TOML="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"

BULLET_TRAIN_URL="https://raw.githubusercontent.com/julienc91/starship-bullet-train/refs/heads/main/starship.toml"

apply_bullet_train() {
    if ! command -v starship >/dev/null 2>&1; then
        echo "starship-config: starship not found; install it first" >&2
        exit 1
    fi

    # Download the upstream preset.
    if ! curl -fsSL --max-time 20 "$BULLET_TRAIN_URL" -o /tmp/starship-bullet-train.toml 2>/dev/null; then
        echo "starship-config: could not fetch bullet-train preset from $BULLET_TRAIN_URL" >&2
        exit 1
    fi

    # Basic sanity check: first non-empty line should look like a starship toml.
    if ! head -n 1 /tmp/starship-bullet-train.toml | grep -qE '^\s*(add_newline|starship|format|\[)'; then
        echo "starship-config: downloaded file does not look like a starship toml; refusing to apply" >&2
        rm -f /tmp/starship-bullet-train.toml
        exit 1
    fi

    # Update the dotfiles source and the live config.
    if [ -f "$DOTFILES_STARSHIP_TOML" ]; then
        cp /tmp/starship-bullet-train.toml "$DOTFILES_STARSHIP_TOML"
        echo "starship-config: updated dotfiles source $DOTFILES_STARSHIP_TOML"
    else
        echo "starship-config: dotfiles source missing: $DOTFILES_STARSHIP_TOML" >&2
    fi

    cp /tmp/starship-bullet-train.toml "$LIVE_STARSHIP_TOML"
    echo "starship-config: applied bullet-train preset from $BULLET_TRAIN_URL -> $LIVE_STARSHIP_TOML"

    rm -f /tmp/starship-bullet-train.toml
}

case "$THEME" in
    bullet-train|bt)
        apply_bullet_train
        ;;
    *)
        echo "starship-config: unknown theme '$THEME' (supported: bullet-train)" >&2
        exit 1
        ;;
esac

# Show the effective prompt config summary.
starship config 2>/dev/null | head -n 40 || true
# NOTE: "ferres" was never found anywhere in this environment (no binary on
# PATH, no crate on crates.io, no reference in dotfiles, not in the bullet-
# train repo). If you meant a different tool, tell me which one and I will
# install or configure it. Otherwise nothing ferres-related is actionable here.
