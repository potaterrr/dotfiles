#!/usr/bin/env bash
# regenerate-fastfetch — rewrite ~/.config/fastfetch/config.jsonc
# to match the running distro + DE/WM, using souravas preset modules/logos.
#
# Mappings:
#   distro  → logo file in ~/.local/share/fastfetch/images/
#   DE/WM   → preset folder (hypr / groups) + module style
#
# Run:  regenerate-fastfetch
#       regenerate-fastfetch --dry-run   (print, don't write)

set -euo pipefail

CONFIG="$HOME/.config/fastfetch/config.jsonc"
SHARE_IMAGES="$HOME/.local/share/fastfetch/images"
SHARE_PRESETS="$HOME/.local/share/fastfetch/presets"

# --- helpers ------------------------------------------------------------------
log()   { printf '==> %s\n' "$*"; }
warn()  { printf 'WARNING: %s\n' "$*" >&2; }
err()   { printf 'ERROR: %s\n' "$*" >&2; }

# Detect distro from /etc/os-release
detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        case "$ID" in
            arch|manjaro|endeavouros) echo "archlinux" ;;
            debian|ubuntu|linuxmint|pop|elementary|kali|raspbian)
                case "$ID" in
                    ubuntu) echo "ubuntu" ;;
                    linuxmint) echo "ubuntu" ;;
                    pop) echo "ubuntu" ;;
                    elementary) echo "ubuntu" ;;
                    kali) echo "debian" ;;
                    raspbian) echo "debian" ;;
                    *) echo "debian" ;;
                esac ;;
            fedora|centos|rocky|almalinux|rhel|ol|amzn)
                case "$ID" in
                    fedora) echo "fedora" ;;
                    centos|rocky|almalinux|rhel|ol|amzn) echo "fedora" ;;  # best-effort
                    *) echo "fedora" ;;
                esac ;;
            *) echo "archlinux" ;;  # default fallback
        esac
    else
        echo "archlinux"
    fi
}

# Detect desktop environment / window manager
detect_wm() {
    # 1. X11: DISPLAY set + loginctl/ps
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v loginctl >/dev/null 2>&1; then
            local seat
            seat="$(loginctl show-session "$XDG_SESSION_ID" -p DesktopManagerWidgetTypeProperties 2>/dev/null | cut -d= -f2 || true)"
            if [ "$seat" = "Hyprland" ] || echo "$seat" | grep -qi hypr; then
                echo "hypr"
                return
            fi
        fi
        # X11 WM from xprop if available
        if command -v xprop >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
            local wm
            wm="$(xprop -root WM_NAME 2>/dev/null | cut -d'"' -f2 || true)"
            case "$wm" in
                Hyprland*) echo "hypr" ;;
                *) echo "groups" ;;
            esac
            return
        fi
        # Wayland: check env
        case "${XDG_CURRENT_DESKTOP:-}" in
            *Hyprland*|*hypr*) echo "hypr" ;;
            *) echo "groups" ;;
        esac
        return
    fi

    # 2. No display (e.g. SSH/non-graphical) — guess from ps or default
    if command -v pgrep >/dev/null 2>&1; then
        if pgrep -x hyprland >/dev/null 2>&1; then
            echo "hypr"
            return
        fi
    fi
    echo "groups"
}

# Package manager format string for the given distro
pkg_format() {
    case "$1" in
        archlinux|manjaro|endeavouros) echo "{} (pacman)" ;;
        debian|ubuntu|linuxmint|pop|elementary|kali|raspbian) echo "{} (apt)" ;;
        fedora|centos|rocky|almalinux|rhel|ol|amzn) echo "{} (dnf)" ;;
        *) echo "{}" ;;
    esac
}

# --- main ---------------------------------------------------------------------
dry_run=0
quiet=0
FAKEFETCH_WM="${FAKEFETCH_WM:-}"
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) dry_run=1 ;;
        --quiet|-q) quiet=1 ;;
    esac
done

# Allow FAKEFETCH_DISTRO override for testing (unset = real /etc/os-release).
FAKEFETCH_DISTRO="${FAKEFETCH_DISTRO:-}"
if [ -n "$FAKEFETCH_DISTRO" ]; then
    DISTRO="$FAKEFETCH_DISTRO"
else
    DISTRO="$(detect_distro)"
fi
# Respect explicit override (for testing from non-graphical sessions),
# otherwise auto-detect from the running session.
if [ -n "$FAKEFETCH_WM" ]; then
    WM="$FAKEFETCH_WM"
else
    WM="$(detect_wm)"
fi
LOGO="$DISTRO.png"
PKG_FMT="$(pkg_format "$DISTRO")"

if [ "$quiet" -eq 0 ]; then log "regenerating fastfetch config for $DISTRO + $WM"; fi

# Validate assets exist
if [ ! -f "$SHARE_IMAGES/$LOGO" ]; then
    warn "logo not found: $SHARE_IMAGES/$LOGO — falling back to debian.png"
    LOGO="debian.png"
fi

# Choose the souravas preset to model config.jsonc on.
# Prefer os/<distro> (matches fastfetch --config os/debian), then
# hypr/<distro>, groups/<distro>, then the archlinux fallback.
if [ -f "$SHARE_PRESETS/os/$DISTRO.jsonc" ]; then
    PRESET_FILE="$SHARE_PRESETS/os/$DISTRO.jsonc"
    PRESET_LABEL="os/$DISTRO"
elif [ -f "$SHARE_PRESETS/hypr/$DISTRO.jsonc" ]; then
    PRESET_FILE="$SHARE_PRESETS/hypr/$DISTRO.jsonc"
    PRESET_LABEL="hypr/$DISTRO"
elif [ -f "$SHARE_PRESETS/groups/$DISTRO.jsonc" ]; then
    PRESET_FILE="$SHARE_PRESETS/groups/$DISTRO.jsonc"
    PRESET_LABEL="groups/$DISTRO"
else
    PRESET_FILE="$SHARE_PRESETS/hypr/archlinux.jsonc"
    PRESET_LABEL="hypr/archlinux (fallback)"
fi

if [ ! -f "$PRESET_FILE" ]; then
    err "no preset found for $DISTRO — aborting"
    exit 1
fi

if [ "$quiet" -eq 0 ]; then log "preset=$PRESET_LABEL"; fi

cat > "$CONFIG.tmp" <<ENDCONFIG
{// generated from souravas presets/$PRESET_LABEL
 "\$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
     "source": "$SHARE_IMAGES/$LOGO",
     "type": "kitty",
     "height": 20,
     "padding": { "top": 2 }
 },
 "display": { "separator": " " },
 "modules": [
     "break", "break",
     { "type": "custom", "format": "\u001b[90m\u273f  \u001b[31m\u273f  \u001b[32m\u273f  \u001b[33m\u273f  \u001b[34m\u273f  \u001b[35m\u273f  \u001b[36m\u273f  \u001b[37m\u273f" },
     "break",
     { "type": "title", "keyWidth": 10 },
     "break",
     { "type": "os",            "key": "\uFD03 ", "keyColor": "34" },
     { "type": "kernel",        "key": "\uF029 ", "keyColor": "34" },
     { "type": "packages",      "format": "$PKG_FMT", "key": "\uEAB9 ", "keyColor": "34" },
     { "type": "shell",         "key": "\uF020 ", "keyColor": "34" },
     { "type": "terminal",      "key": "\uF6D6 ", "keyColor": "34" },
     { "type": "wm",            "key": "\uF0C1 ", "keyColor": "34" },
     { "type": "cursor",        "key": "\uE823 ", "keyColor": "34" },
     { "type": "terminalfont",  "key": "\uF121 ", "keyColor": "34" },
     { "type": "uptime",        "key": "\uE5C5 ", "keyColor": "34" },
     { "type": "datetime",      "format": "{1}-{3}-{11}", "key": "\uF4C5 ", "keyColor": "34" },
     { "type": "media",         "key": "\uE925 ", "keyColor": "34" },
     { "type": "player",        "key": "\uF26C ", "keyColor": "34" },
     "break",
     { "type": "custom", "format": "\u001b[90m\u273f  \u001b[31m\u273f  \u001b[32m\u273f  \u001b[33m\u273f  \u001b[34m\u273f  \u001b[35m\u273f  \u001b[36m\u273f  \u001b[37m\u273f" },
     "break"
 ]
}
ENDCONFIG

if [ "$dry_run" -eq 1 ]; then
    log "dry-run: would write $CONFIG.tmp"
    cat "$CONFIG.tmp"
    rm -f "$CONFIG.tmp"
    exit 0
fi

mv "$CONFIG.tmp" "$CONFIG"
if [ "$quiet" -eq 0 ]; then log "wrote $CONFIG (preset: $PRESET_LABEL)"; fi
